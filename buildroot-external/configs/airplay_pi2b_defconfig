# Basis: configs/raspberrypi2_defconfig (Buildroot 2025.02)
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi2/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/raspberrypi2/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2709"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2709-rpi-2-b broadcom/bcm2710-rpi-2-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
# USB-WLAN: schaltet RTL8XXXU_UNTESTED frei (u.a. Edimax N150 V1),
# siehe 4.6 weiter unten und board/airplay-pi2b/linux-usb-wifi.fragment
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay-pi2b/linux-usb-wifi.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay-pi2b/config_pi2b.txt"
# Anders als raspberrypizero2w_defconfig ist das bei raspberrypi2_defconfig
# NICHT standardmäßig an - ohne das landet hifiberry-dacplus-std.dtbo nicht
# auf der Boot-Partition und der Amp4-Overlay kann nicht laden.
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="120M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y

# --- Anleitung Phase 4: Paketauswahl AirPlay-Streamer (Amp4), Pi 2B-Variante ---

# 4.1 System-Grundeinstellungen
BR2_TARGET_GENERIC_HOSTNAME="airplay-pi2b"
# ACHTUNG: Platzhalter - vor dem Bauen/Flashen aendern
# (make menuconfig -> System configuration -> Root password), niemals ein
# echtes Passwort hier committen.
BR2_TARGET_GENERIC_ROOT_PASSWD="changeme-before-flashing"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay-pi2b/rootfs-overlay"

# 4.2 AirPlay-Empfaenger (Classic AirPlay 1)
BR2_PACKAGE_SHAIRPORT_SYNC=y
BR2_PACKAGE_SHAIRPORT_SYNC_LIBSOXR=y

# 4.3 mDNS (Bonjour-Discovery)
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y

# 4.4 ALSA-Werkzeuge
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# 4.5 Software-EQ (statische Variante, Anhang B statt alsaequal -
# alsaequal ist kein offizielles Buildroot-Paket und kaum gepflegte Software.
# caps liefert Eq10, alsa-lib bringt die "type ladspa"-PCM-Plugin bereits mit)
BR2_PACKAGE_CAPS=y

# 4.6 Netzwerk: Ethernet (immer) + optionaler USB-WLAN-Stick
# Der Pi 2B hat keinen eingebauten WLAN-Chip. rtl8xxxu und rt2800usb sind im
# bcm2709-Kernel-Defconfig bereits als Module aktiv (CONFIG_RTL8XXXU=m,
# CONFIG_RT2800USB=m) - hier nur noch wpa_supplicant + die passende Firmware.
# rtl8xxxu deckt auch den Edimax N150 ab (RTL8188EU seit Kernel 6.3;
# RTL8188CUS-Variante braucht RTL8XXXU_UNTESTED aus dem Fragment oben),
# Firmware fuer beide steckt in RTL_81XX.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_LINUX_FIRMWARE=y
# Realtek RTL8188CUS/RTL8192CU/RTL8188EU (rtl8xxxu-Treiber)
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
# Ralink/MediaTek RT2870/RT3070/RT5370 (rt2800usb-Treiber)
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y

# 4.7 SSH
BR2_PACKAGE_DROPBEAR=y
