#!/bin/sh
#
# Startet shairport-sync nach dbus (S30) und avahi (S50).
#
DAEMON=/usr/bin/shairport-sync
PIDFILE=/var/run/shairport-sync.pid
CONF=/etc/shairport-sync.conf

case "$1" in
    start)
        # Hardware-Lautstaerke-Deckel (Schutz der Lautsprecher): der Treiber
        # startet sonst mit 0dB Vollgas. shairport-sync regelt in Software
        # unterhalb dieses Werts (kein mixer_control_name gesetzt).
        amixer -c 0 sset Digital -- -6dB >/dev/null 2>&1
        printf "Starting shairport-sync: "
        start-stop-daemon -S -b -m -p "$PIDFILE" \
            -x "$DAEMON" -- -c "$CONF"
        echo "OK"
        ;;
    stop)
        printf "Stopping shairport-sync: "
        start-stop-daemon -K -q -p "$PIDFILE"
        echo "OK"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
